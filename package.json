{
  "name": "sigil-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node tools/ensure-exports.mjs",
    "start": "ng serve",
    "build:exports": "ng build --configuration standalone && node tools/pack-viewer.mjs && node tools/pack-source.mjs",
    "prebuild": "npm run build:exports",
    "build": "ng build",
    "build:public": "ng build --configuration public",
    "serve:dist": "node tools/serve-dist.mjs",
    "lift": "node tools/lift.mjs tools/lift-export.json && node tools/lift.mjs tools/lift-motion.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "e2e": "node e2e/run.mjs",
    "check:structure": "node tools/check-structure.mjs",
    "fixtures": "node tools/make-fixtures.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
